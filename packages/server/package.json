{
    "name": "@counterscale/server",
    "version": "3.4.1",
    "description": "Pulse Analytics server",
    "homepage": "https://pulse-analytics.chimezieinnocent39.workers.dev",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/Vic-Orlands/Pulse-analytics",
        "directory": "packages/server"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "files": [
        "build",
        "app",
        "workers",
        "wrangler.json"
    ],
    "scripts": {
        "dev": "vite dev",
        "prebuild": "pnpm copytracker",
        "build": "vite build",
        "preview": "pnpm build && wrangler dev",
        "deploy": "pnpm build && wrangler deploy",
        "lint": "eslint src",
        "test": "vitest run",
        "test-ci": "vitest run --coverage",
        "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "prepare": "husky",
        "types:gen": "wrangler types",
        "copytracker": "cp ../tracker/dist/loader/tracker.js ./static/tracker.js"
    },
    "dependencies": {
        "@counterscale/tracker": "*",
        "@fontsource-variable/manrope": "^5.2.7",
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.2.7",
        "@fontsource/instrument-serif": "^5.3.0",
        "@hugeicons/core-free-icons": "^4.2.3",
        "@hugeicons/svelte": "^1.1.4",
        "apache-arrow": "^21.1.0",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.11",
        "isbot": "^5.1.9",
        "layerchart": "^2.0.4",
        "motion": "^12.23.24",
        "tailwind-merge": "^2.3.0",
        "ua-parser-js": "^1.0.38"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260804.1",
        "@counterscale/eslint-config": "workspace:*",
        "@sveltejs/adapter-cloudflare": "^7.2.9",
        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.10.2",
        "@types/ua-parser-js": "^0.7.39",
        "@typescript-eslint/eslint-plugin": "^8.26.1",
        "@typescript-eslint/parser": "^8.26.1",
        "@vitest/coverage-istanbul": "~4.0.8",
        "@vitest/coverage-v8": "~4.0.8",
        "globals": "^16.0.0",
        "husky": "^9.0.11",
        "svelte": "^5.56.8",
        "svelte-check": "^4.3.4",
        "tailwindcss": "^4.1.11",
        "typescript": "^5.7.2",
        "vite": "^7.2.2",
        "vitest": "~4.0.8",
        "wrangler": "^4.23.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
